class Solution {
    public int[] getSumAbsoluteDifferences(int[] nums) {
        int n = nums.length;
        int[] result = new int[n];
        
        // Calculate the total sum of the array first (total suffix sum)
        int totalSum = 0;
        for (int num : nums) {
            totalSum += num;
        }
        
        int prefixSum = 0;
        
        for (int i = 0; i < n; i++) {
            // Suffix sum for elements strictly after index i
            int suffixSum = totalSum - prefixSum - nums[i];
            
            // Calculate absolute difference sums for left and right portions
            int leftCount = i;
            int rightCount = n - 1 - i;
            
            int leftSum = leftCount * nums[i] - prefixSum;
            int rightSum = suffixSum - rightCount * nums[i];
            
            result[i] = leftSum + rightSum;
            
            // Include current element into prefix sum for the next iteration
            prefixSum += nums[i];
        }
        
        return result;
    }
}
